{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "",
  "title": "Mock Definition",
  "description": "Describes an HTTP mock definition. The decoder in mockhttp/mock_schema.go is the reference; tests keep this schema in step with it.",
  "type": "object",
  "properties": {
    "id": {
      "description": "ID of the mock, in place of a generated one.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._~-]+$"
    },
    "name": { "type": "string" },
    "priority": { "description": "Mocks with a lower priority are matched first.", "type": "integer" },
    "enabled": { "$ref": "#/$defs/bool" },
    "delay": { "$ref": "#/$defs/duration" },
    "repeat": { "type": "integer", "minimum": 1 },
    "scenario": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "required_state": { "type": "string" },
        "new_state": { "type": "string" }
      },
      "required": [ "name" ],
      "additionalProperties": false
    },
    "on_complete": { "type": "array", "items": { "$ref": "#/$defs/on_complete_event" } },
    "request": {
      "type": "object",
      "properties": {
        "scheme": { "$ref": "#/$defs/matcher" },
        "method": { "$ref": "#/$defs/matcher" },
        "path": { "$ref": "#/$defs/matcher" },
        "url": { "$ref": "#/$defs/matcher" },
        "url_match": { "type": "string", "format": "regex" },
        "query": { "$ref": "#/$defs/keyed_matcher" },
        "queries": { "$ref": "#/$defs/keyed_matcher" },
        "header": { "$ref": "#/$defs/keyed_matcher" },
        "form": { "description": "Fields of a urlencoded or multipart form body, by name.", "$ref": "#/$defs/keyed_matcher" },
        "form_file": {
          "description": "Files of a multipart form body, by field name: a pattern, or a list of patterns, each met by some file of the field.",
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "oneOf": [
                { "$ref": "#/$defs/file_pattern" },
                { "type": "array", "items": { "$ref": "#/$defs/file_pattern" } }
              ]
            }
          }
        },
        "body": { "$ref": "#/$defs/matcher" }
      },
      "minProperties": 1,
      "additionalProperties": false,
      "allOf": [
        { "not": { "required": [ "url", "url_match" ] } },
        { "not": { "required": [ "url", "path" ] } },
        { "not": { "required": [ "url_match", "path" ] } }
      ]
    },
    "response": { "$ref": "#/$defs/reply" },
    "response_sequence": {
      "type": "object",
      "properties": {
        "responses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reply" } },
        "after_ended": { "$ref": "#/$defs/reply" }
      },
      "required": [ "responses" ],
      "additionalProperties": false
    },
    "response_random": {
      "type": "object",
      "properties": {
        "responses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reply" } },
        "seed": { "type": "integer" }
      },
      "required": [ "responses" ],
      "additionalProperties": false
    },
    "proxy": {
      "type": "object",
      "properties": {
        "target": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^/]+" },
        "forward_header": { "$ref": "#/$defs/header_map" },
        "header": { "$ref": "#/$defs/header_map" },
        "remove_headers": { "type": "array", "items": { "type": "string" } },
        "trim_prefix": { "type": "string" },
        "trim_suffix": { "type": "string" },
        "timeout": { "$ref": "#/$defs/duration" },
        "ssl_verify": { "$ref": "#/$defs/bool" },
        "no_follow": { "$ref": "#/$defs/bool" }
      },
      "required": [ "target" ],
      "additionalProperties": false
    },
    "ext": { "description": "Settings for the MockFileHandlers of the server.", "type": "object" }
  },
  "required": [ "request" ],
  "additionalProperties": false,
  "allOf": [
    { "not": { "required": [ "response", "response_sequence" ] } },
    { "not": { "required": [ "response", "response_random" ] } },
    { "not": { "required": [ "response", "proxy" ] } },
    { "not": { "required": [ "response_sequence", "response_random" ] } },
    { "not": { "required": [ "response_sequence", "proxy" ] } },
    { "not": { "required": [ "response_random", "proxy" ] } }
  ],
  "$defs": {
    "duration": {
      "description": "Whole milliseconds, or an unsigned Go duration such as 1.5s.",
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 9223372036854 },
        { "type": "string", "pattern": "^(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|\u00b5s|\u03bcs|ms|s|m|h))+)$" }
      ]
    },
    "bool": {
      "description": "A bool, or what Go's strconv.ParseBool reads: 1, t, T, TRUE, true, True and their false forms, or the number 1 or 0.",
      "oneOf": [
        { "type": "boolean" },
        { "enum": [ 0, 1, "1", "t", "T", "TRUE", "true", "True", "0", "f", "F", "FALSE", "false", "False" ] }
      ]
    },
    "matcher": {
      "description": "A string, compared as is, or a matcher list such as [\"contains\", \"x\"].",
      "oneOf": [
        { "type": "string" },
        { "type": "array", "minItems": 1 }
      ]
    },
    "keyed_matcher": {
      "type": "object",
      "patternProperties": {
        "^.*$": { "$ref": "#/$defs/matcher" }
      }
    },
    "file_pattern": {
      "description": "What a file of a multipart form must have. {} matches any file.",
      "type": "object",
      "properties": {
        "filename": { "description": "The file's name, as Go reads it: its base.", "$ref": "#/$defs/matcher" },
        "content_type": { "description": "The media type: in lower case, without parameters, or empty when absent.", "$ref": "#/$defs/matcher" },
        "header": { "description": "Headers of the file's part.", "$ref": "#/$defs/keyed_matcher" },
        "body": { "description": "The content, as text.", "$ref": "#/$defs/matcher" },
        "body_file": { "description": "A file the content must equal. Relative paths start at the mock file's directory.", "type": "string", "minLength": 1 },
        "every": { "description": "Match when every file of the field matches, rather than some file.", "$ref": "#/$defs/bool" }
      },
      "additionalProperties": false,
      "not": { "required": [ "body", "body_file" ] }
    },
    "reply": {
      "type": "object",
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "header": { "$ref": "#/$defs/header_map" },
        "header_template": { "$ref": "#/$defs/header_map" },
        "trailer": { "$ref": "#/$defs/header_map" },
        "body": { "description": "Text as is; anything else as JSON.", "not": { "type": "null" } },
        "body_file": { "description": "Relative paths start at the mock file's directory.", "type": "string", "minLength": 1 },
        "multipart": { "$ref": "#/$defs/multipart" },
        "template": {
          "type": "object",
          "properties": {
            "enabled": { "$ref": "#/$defs/bool" },
            "data": { "oneOf": [ { "type": "object" }, { "type": "array" } ] }
          },
          "additionalProperties": false
        },
        "encoding": { "enum": [ "gzip" ] }
      },
      "additionalProperties": false,
      "allOf": [
        { "not": { "required": [ "body", "body_file" ] } },
        { "not": { "required": [ "body", "multipart" ] } },
        { "not": { "required": [ "body_file", "multipart" ] } }
      ]
    },
    "multipart": {
      "description": "A multipart body, written with Go's multipart writer. It sets the Content-Type, with its boundary.",
      "type": "object",
      "properties": {
        "type": { "description": "The subtype only, such as form-data, mixed, related or x-mixed-replace.", "type": "string", "pattern": "^[!#$%&'*+.^_`|~{}0-9A-Za-z-]+$" },
        "boundary": { "description": "1 to 70 letters, digits or '()+_,-./:=? characters, not ending in a space. Random when left out.", "type": "string", "pattern": "^[0-9A-Za-z'()+_,./:=? -]{0,69}[0-9A-Za-z'()+_,./:=?-]$" },
        "params": {
          "description": "More parameters of the Content-Type, such as type and start.",
          "type": "object",
          "propertyNames": { "pattern": "^[!#$%&'*+.^_`|~{}0-9A-Za-z-]+$", "not": { "pattern": "^[Bb][Oo][Uu][Nn][Dd][Aa][Rr][Yy]$" } },
          "additionalProperties": { "type": "string" }
        },
        "parts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/multipart_part" } }
      },
      "required": [ "type", "parts" ],
      "additionalProperties": false,
      "if": { "properties": { "type": { "const": "form-data" } }, "required": [ "type" ] },
      "then": { "properties": { "parts": { "items": { "required": [ "name" ] } } } }
    },
    "multipart_part": {
      "type": "object",
      "properties": {
        "name": { "description": "Name of the part, in its Content-Disposition: required in form-data.", "type": "string" },
        "filename": { "type": "string" },
        "content_type": { "description": "JSON bodies default to application/json, and parts with a filename to application/octet-stream.", "type": "string" },
        "header": { "$ref": "#/$defs/header_map" },
        "body": { "description": "Text as is; anything else as JSON.", "not": { "type": "null" } },
        "body_file": { "description": "Read at each reply. Relative paths start at the mock file's directory.", "type": "string", "minLength": 1 },
        "delay": { "description": "How long a reply waits before writing the part.", "$ref": "#/$defs/duration" }
      },
      "additionalProperties": false,
      "not": { "required": [ "body", "body_file" ] }
    },
    "on_complete_event": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "parameters": { }
      },
      "additionalProperties": false,
      "required": [ "name" ]
    },
    "header_map": {
      "type": "object",
      "patternProperties": {
        "^.*$": { "oneOf": [ {"type": "string"}, {"type": "array", "items": {"type": "string"} } ] }
      }
    }
  }
}
